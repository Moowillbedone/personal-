# Copy to .env for local runs. In GitHub Actions these come from repo Secrets.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key, NEVER commit

# Alpaca — used by poll.py (signal tracker) AND sync_assets.py (trade feature).
ALPACA_KEY_ID=PK...
ALPACA_SECRET=...

# Match the Vercel server settings and GitHub repository Secrets.
# Used only by ai_scan.py / market_wrap.py for private front-end APIs.
FRONT_URL=https://stock-tracker-khaki-mu.vercel.app
STOCK_TRACKER_OWNER_USER=owner
# Required: unique ASCII secret, at least 20 characters. Never commit it.
STOCK_TRACKER_OWNER_PASSWORD=
